{
	"name": "@lukstei/dsh-client-review-git",
	"version": "0.2.2-rc.5.2",
	"description": "Git diff and GitButler change view client plugin for DeepSeek Harness",
	"type": "module",
	"main": "./dist/host.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/host.js"
		},
		"./client": "./dist/client.js",
		"./client-contract": {
			"types": "./src/client/contract.ts"
		},
		"./typert": {
			"types": "./lib/typert.host.d.ts",
			"default": "./lib/typert.host.js"
		},
		"./remote": {
			"types": "./lib/typert.remote-client.d.ts",
			"default": "./lib/typert.remote-client.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"dist",
		"lib/typert.host.js",
		"lib/typert.host.d.ts",
		"lib/typert.remote-client.js",
		"lib/typert.remote-client.d.ts",
		"lib/typert.remote-client.d.ts.map",
		"README.md",
		"cordis.patch.yml",
		"!src/**/*.spec.*",
		"!src/**/*.test.*",
		"!src/**/*.stories.*",
		"!src/**/stories",
		"!src/**/*.e2e.*",
		"!src/**/__snapshots__",
		"!src/**/fixtures"
	],
	"scripts": {
		"gen:typert": "node scripts/gen-typert.ts",
		"build": "pnpm --silent run gen:typert && tsdown --config tsdown.config.ts --logLevel error",
		"dev": "pnpm run gen:typert && tsdown --config tsdown.config.ts --watch",
		"check": "biome check --reporter=concise .",
		"typecheck": "pnpm --silent run gen:typert && tsc --noEmit",
		"test": "vitest run --reporter=minimal",
		"test:integration": "vitest run --config vitest.integration.config.ts --reporter=minimal",
		"test:watch": "vitest",
		"test:update": "vitest run -u",
		"verify": "pnpm --silent run check && pnpm --silent run build && pnpm --silent run typecheck && pnpm --silent run test && pnpm --silent run test:integration",
		"ladle": "ladle serve",
		"ladle:build": "ladle build",
		"prepack": "pnpm run build"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-chat",
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-slots",
				"@deepseek-ai/dsh-client-ui-sidebar-right",
				"@deepseek-ai/dsh-api-gateway"
			]
		}
	},
	"dependencies": {
		"@lukstei/util-review-ui": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "catalog:",
		"@deepseek-ai/dsh-agent": "catalog:",
		"@deepseek-ai/dsh-api-gateway": "catalog:",
		"@deepseek-ai/dsh-api-session-controller": "catalog:",
		"@deepseek-ai/dsh-api-workspace-files": "catalog:",
		"@deepseek-ai/dsh-client-store": "catalog:",
		"@deepseek-ai/dsh-client-ui-chat": "catalog:",
		"@deepseek-ai/dsh-client-ui-conversation": "catalog:",
		"@deepseek-ai/dsh-client-ui-primitives": "catalog:",
		"@deepseek-ai/dsh-client-ui-renderer": "catalog:",
		"@deepseek-ai/dsh-client-ui-session": "catalog:",
		"@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "catalog:",
		"@deepseek-ai/dsh-client-ui-sidebar-right": "catalog:",
		"@deepseek-ai/dsh-client-ui-slots": "catalog:",
		"@deepseek-ai/dsh-commands": "catalog:",
		"@deepseek-ai/dsh-llm": "catalog:",
		"@deepseek-ai/dsh-session": "catalog:",
		"@deepseek-ai/dsh-session-persistence": "catalog:",
		"@deepseek-ai/dsh-tool-executor-ptc": "catalog:",
		"@deepseek-ai/dsh-tool-present": "catalog:",
		"@deepseek-ai/dsh-tools": "catalog:",
		"@deepseek-ai/dsh-typert-generator": "catalog:",
		"@deepseek-ai/dsh-typert-protocol": "catalog:",
		"@deepseek-ai/dsh-util-code-language": "catalog:",
		"@deepseek-ai/dsh-util-workspace-path": "catalog:",
		"@deepseek-ai/dsh-working-directory": "catalog:",
		"@ladle/react": "catalog:",
		"@lukstei/dsh-client-split-view": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"anser": "catalog:",
		"happy-dom": "catalog:",
		"immer": "catalog:",
		"katex": "catalog:",
		"lightningcss": "catalog:",
		"mdast-util-math": "catalog:",
		"micromark-extension-math": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"simple-icons": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"typescript-transpile": "catalog:",
		"vitest": "catalog:",
		"zustand": "catalog:"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "*",
		"@deepseek-ai/dsh-agent": "*",
		"@deepseek-ai/dsh-api-gateway": "*",
		"@deepseek-ai/dsh-api-session-controller": "*",
		"@deepseek-ai/dsh-client-ui-chat": "*",
		"@deepseek-ai/dsh-client-ui-conversation": "*",
		"@deepseek-ai/dsh-client-ui-primitives": "*",
		"@deepseek-ai/dsh-client-ui-renderer": "*",
		"@deepseek-ai/dsh-client-ui-sidebar-right": "*",
		"@deepseek-ai/dsh-client-ui-slots": "*",
		"@deepseek-ai/dsh-commands": "*",
		"@deepseek-ai/dsh-session": "*",
		"@deepseek-ai/dsh-session-persistence": "*",
		"@deepseek-ai/dsh-tool-executor-ptc": "*",
		"@deepseek-ai/dsh-tool-present": "*",
		"@deepseek-ai/dsh-tools": "*",
		"@deepseek-ai/dsh-typert-protocol": "*",
		"@deepseek-ai/dsh-util-workspace-path": "*",
		"@deepseek-ai/dsh-working-directory": "*",
		"react": "*"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukstei/dsh-plugins.git",
		"directory": "packages/dsh-client-review-git"
	},
	"publishConfig": {
		"access": "public"
	}
}
