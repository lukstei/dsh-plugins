{
	"workflow": {
		"name": "Conditional Output Skipped",
		"description": "Minimal reproducing example of disabling a step with an output and referencing that output downstream",
		"args": {
			"smells": {
				"type": "bool",
				"default": "true",
				"required": false
			}
		},
		"steps": [
			{
				"kind": "subagent",
				"name": "Antipattern Scan",
				"prompt": "Scan code for antipatterns",
				"config": {
					"provider": "spawn"
				},
				"output": "smell_findings",
				"if": "{{args.smells}}"
			},
			{
				"kind": "print",
				"name": "Triage",
				"text": "Triage findings: {{outputs.smell_findings}}"
			}
		]
	},
	"invocation": {
		"targetPath": "workflow.yaml",
		"rawInput": "workflow.yaml smells=false",
		"resolvedArgs": {
			"smells": "false"
		},
		"runId": "e2e-conditional-output-skipped-run"
	},
	"state": {
		"stepIndex": 2,
		"status": "completed"
	}
}
