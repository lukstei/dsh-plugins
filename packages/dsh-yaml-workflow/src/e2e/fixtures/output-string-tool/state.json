{
	"workflow": {
		"name": "Generate Release Version",
		"description": "Agent calculates release tag string and logs via save_output tool",
		"args": {},
		"steps": [
			{
				"kind": "prompt",
				"name": "Calculate Semantic Tag",
				"prompt": "Determine next semver tag",
