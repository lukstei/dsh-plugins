{
	"name": "@lukstei/dsh-yaml-workflow",
	"version": "0.2.2-rc.5.14",
	"description": "Execute sequential prompt workflows from YAML",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./client": "./dist/client.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"dist",
		"examples",
		"README.md",
		"cordis.patch.yml",
		"!src/**/*.spec.*",
		"!src/**/*.test.*",
		"!src/**/*.stories.*",
		"!src/**/stories",
		"!src/**/*.e2e.*",
		"!src/**/__snapshots__",
		"!src/**/fixtures",
		"!src/e2e"
	],
	"scripts": {
		"build": "tsdown --config tsdown.config.ts --logLevel error",
		"dev": "tsdown --config tsdown.config.ts --watch",
		"check": "biome check --reporter=concise .",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run build && vitest run --reporter=minimal",
		"test:e2e": "vitest run --config vitest.e2e.config.ts --coverage --reporter=minimal",
		"test:watch": "vitest",
		"test:update": "vitest run -u",
		"verify": "pnpm --silent run check && pnpm --silent run build && pnpm --silent run typecheck && pnpm --silent run test && pnpm --silent run test:e2e",
		"ladle": "ladle serve",
		"ladle:build": "ladle build",
		"prepack": "pnpm run build"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-client-ui-chat",
				"@deepseek-ai/dsh-client-ui-slots",
				"@deepseek-ai/dsh-client-ui-conversation"
			]
		}
	},
	"dependencies": {
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "catalog:",
		"@deepseek-ai/dsh-agent": "catalog:",
		"@deepseek-ai/dsh-api-session-controller": "catalog:",
		"@deepseek-ai/dsh-client-store": "catalog:",
		"@deepseek-ai/dsh-client-ui-chat": "catalog:",
		"@deepseek-ai/dsh-client-ui-conversation": "catalog:",
		"@deepseek-ai/dsh-client-ui-renderer": "catalog:",
		"@deepseek-ai/dsh-client-ui-slots": "catalog:",
		"@deepseek-ai/dsh-commands": "catalog:",
		"@deepseek-ai/dsh-llm": "catalog:",
		"@deepseek-ai/dsh-session": "catalog:",
		"@deepseek-ai/dsh-session-projection": "catalog:",
		"@deepseek-ai/dsh-session-title": "catalog:",
		"@deepseek-ai/dsh-subagent": "catalog:",
		"@deepseek-ai/dsh-tools": "catalog:",
		"@ladle/react": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"immer": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zustand": "catalog:"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "*",
		"@deepseek-ai/dsh-agent": "*",
		"@deepseek-ai/dsh-api-session-controller": "*",
		"@deepseek-ai/dsh-client-ui-chat": "*",
		"@deepseek-ai/dsh-client-ui-conversation": "*",
		"@deepseek-ai/dsh-client-ui-slots": "*",
		"@deepseek-ai/dsh-commands": "*",
		"@deepseek-ai/dsh-llm": "*",
		"@deepseek-ai/dsh-session": "*",
		"@deepseek-ai/dsh-session-projection": "*",
		"@deepseek-ai/dsh-session-title": "*",
		"@deepseek-ai/dsh-skill": "*",
		"@deepseek-ai/dsh-subagent": "*",
		"@deepseek-ai/dsh-tools": "*",
		"react": "*"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukstei/dsh-plugins.git",
		"directory": "packages/dsh-yaml-workflow"
	},
	"publishConfig": {
		"access": "public"
	}
}
