{
	"name": "@lukstei/dsh-client-kanban",
	"version": "0.2.2-rc.5.6",
	"description": "Multi-session vertical Kanban board plugin for DeepSeek Harness with native host persistence",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./client": "./dist/client.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"dist",
		"README.md",
		"cordis.patch.yml",
		"!src/**/*.spec.*",
		"!src/**/*.test.*",
		"!src/**/*.stories.*",
		"!src/**/stories",
		"!src/**/*.e2e.*",
		"!src/**/__snapshots__",
		"!src/**/fixtures"
	],
	"scripts": {
		"build": "tsdown --config tsdown.config.ts --logLevel error",
		"dev": "tsdown --config tsdown.config.ts --watch",
		"check": "biome check --reporter=concise .",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run build && vitest run --reporter=minimal",
		"test:watch": "vitest",
		"test:update": "vitest run -u",
		"verify": "pnpm --silent run check && pnpm --silent run build && pnpm --silent run typecheck && pnpm --silent run test",
		"ladle": "ladle serve",
		"ladle:build": "mkdir -p build && ladle build",
		"prepack": "pnpm run build"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-api-gateway",
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-api-workspace-controller",
				"@deepseek-ai/dsh-api-remotes",
				"@deepseek-ai/dsh-client-ui-slots",
				"@deepseek-ai/dsh-client-ui-workspace",
				"@deepseek-ai/dsh-client-ui-sidebar",
				"@deepseek-ai/dsh-client-ui-layout",
				"@deepseek-ai/dsh-client-ui-session",
				"@deepseek-ai/dsh-client-ui-chat",
				"@deepseek-ai/dsh-client-ui-conversation"
			]
		}
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "catalog:",
		"@deepseek-ai/dsh-agent": "catalog:",
		"@deepseek-ai/dsh-api-gateway": "catalog:",
		"@deepseek-ai/dsh-api-remote-access": "catalog:",
		"@deepseek-ai/dsh-api-remotes": "catalog:",
		"@deepseek-ai/dsh-api-session-controller": "catalog:",
		"@deepseek-ai/dsh-api-workspace-controller": "catalog:",
		"@deepseek-ai/dsh-api-workspace-files": "catalog:",
		"@deepseek-ai/dsh-client-store": "catalog:",
		"@deepseek-ai/dsh-client-ui-chat": "catalog:",
		"@deepseek-ai/dsh-client-ui-conversation": "catalog:",
		"@deepseek-ai/dsh-client-ui-layout": "catalog:",
		"@deepseek-ai/dsh-client-ui-primitives": "catalog:",
		"@deepseek-ai/dsh-client-ui-renderer": "catalog:",
		"@deepseek-ai/dsh-client-ui-session": "catalog:",
		"@deepseek-ai/dsh-client-ui-sidebar": "catalog:",
		"@deepseek-ai/dsh-client-ui-slots": "catalog:",
		"@deepseek-ai/dsh-client-ui-workspace": "catalog:",
		"@deepseek-ai/dsh-commands": "catalog:",
		"@deepseek-ai/dsh-session": "catalog:",
		"@deepseek-ai/dsh-session-projection": "catalog:",
		"@deepseek-ai/dsh-session-query": "catalog:",
		"@deepseek-ai/dsh-tools": "catalog:",
		"@deepseek-ai/dsh-typert-protocol": "catalog:",
		"@deepseek-ai/dsh-typert-registry": "catalog:",
		"@deepseek-ai/dsh-util-code-language": "catalog:",
		"@deepseek-ai/dsh-util-workspace-path": "catalog:",
		"@deepseek-ai/schemastery": "catalog:",
		"@ladle/react": "catalog:",
		"@lukstei/dsh-client-favicon": "workspace:*",
		"@lukstei/dsh-client-notify": "workspace:*",
		"@lukstei/dsh-client-split-view": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "*",
		"@deepseek-ai/dsh-agent": "*",
		"@deepseek-ai/dsh-api-gateway": "*",
		"@deepseek-ai/dsh-api-remote-access": "*",
		"@deepseek-ai/dsh-api-session-controller": "*",
		"@deepseek-ai/dsh-api-workspace-controller": "*",
		"@deepseek-ai/dsh-client-store": "*",
		"@deepseek-ai/dsh-client-ui-primitives": "*",
		"@deepseek-ai/dsh-client-ui-session": "*",
		"@deepseek-ai/dsh-client-ui-sidebar": "*",
		"@deepseek-ai/dsh-client-ui-slots": "*",
		"@deepseek-ai/dsh-commands": "*",
		"@deepseek-ai/dsh-session": "*",
		"@deepseek-ai/dsh-session-query": "*",
		"@deepseek-ai/dsh-tools": "*",
		"@deepseek-ai/dsh-typert-protocol": "*",
		"@deepseek-ai/dsh-typert-registry": "*",
		"@deepseek-ai/dsh-util-workspace-path": "*",
		"@deepseek-ai/schemastery": "*",
		"react": "*"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukstei/dsh-plugins.git",
		"directory": "packages/dsh-client-kanban"
	},
	"publishConfig": {
		"access": "public"
	}
}
